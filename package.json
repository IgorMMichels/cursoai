{
  "name": "cripto-mentoria",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "bots:install": "npm ci --prefix bots",
    "bots:start": "npm start --prefix bots",
    "bots:demo": "npm run demo --prefix bots",
    "bots:collect": "npm run collect --prefix bots",
    "bots:test": "npm test --prefix bots",
    "bots:export": "npm run export --prefix bots",
    "build": "tsc -b && vite build && node scripts/prerender-learning.mjs",
    "test:tools": "node --experimental-strip-types --test src/lib/tool-calculations.test.ts",
    "test:i18n": "node --experimental-strip-types --test src/lib/localization.test.ts src/lib/ui-translation.test.ts",
    "test:email": "node --experimental-strip-types --test server/email/*.test.ts src/lib/auth-callback.test.ts",
    "email:configure": "node scripts/configure-email.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@supabase/supabase-js": "2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "framer-motion": "^13.4.4",
    "gsap": "^3.15.0",
    "i18next": "^26.4.2",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "stripe": "22.6.0",
    "tailwindcss": "^4.3.3",
    "three-stdlib": "^2.36.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "shadcn": "^4.21.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
