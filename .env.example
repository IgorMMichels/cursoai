# Server-only Pix payments through Asaas. Use a sandbox key while testing; ASAAS_ENVIRONMENT defaults to sandbox.
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
# Token configured in the Asaas webhook panel; sent back in the asaas-access-token header.
ASAAS_WEBHOOK_TOKEN=
# Server-only Solana payments. Never prefix these with VITE_. Use devnet and a test address first.
# Public address (never a seed phrase or private key) of the wallet that receives SOL.
SOLANA_MERCHANT_ADDRESS=
# "devnet", "mainnet-beta" or a full RPC URL from a provider (the URL may contain a secret key).
SOLANA_RPC_URL=
# Optional label for the UI when the RPC URL does not say which network it is (devnet, testnet, mainnet-beta).
SOLANA_CLUSTER=
EMAIL_UNSUBSCRIBE_SECRET=
MARKETING_COMPANY_NAME=Omega Courses
MARKETING_POSTAL_ADDRESS=
MARKETING_EMAILS_ENABLED=false
# Local-only billing region simulation for Vite: BR, US, ES, or a country in the euro area.
OMEGA_DEV_COUNTRY=
